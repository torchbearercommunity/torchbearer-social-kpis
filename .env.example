# Copy to .env (gitignored). Every value is optional: a missing credential just
# means that platform falls back to browser collection. Setup: docs/api-setup.md

# Discord channel webhook — the weekly run posts its summary here.
DISCORD_WEBHOOK_URL=

# YouTube Data API v3 key (subscriber count). Free.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCo1kAWa39iW5DPIHk__qvXQ
# YouTube Analytics (weekly views, likes, comments, watch hours). Use the refresh
# token trio for unattended runs; a bare access token expires after an hour.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Meta Graph API — long-lived Page access token with pages_read_engagement,
# read_insights, instagram_basic, instagram_manage_insights.
META_PAGE_TOKEN=
META_PAGE_ID=

# Threads API user token with threads_basic + threads_manage_insights.
THREADS_ACCESS_TOKEN=

# Bluesky needs no credentials (public API).
BLUESKY_HANDLE=jointorchbearer.bsky.social
